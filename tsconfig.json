{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // ponytail: unused-symbol checks are off for now — they flagged 133 pre-existing
    // findings that are noise, not bugs, and would drown out real type errors.
    // Upgrade path: flip both to true and clear the backlog file-by-file.
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
